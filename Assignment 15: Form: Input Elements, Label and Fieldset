<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Assignment 15 - Form Inputs</title>
</head>
<body>
<form>
<fieldset>
<legend>Personal Details</legend>
<p><label for="name">Name:</label>
<input type="text" id="name" name="name"></p>
<p><label for="email">Email:</label>
<input type="email" id="email" name="email"></p>
<p><label for="pass">Password:</label>
<input type="password" id="pass" name="password"></p>
<p>Gender:
<input type="radio" id="m" name="gender" value="male"><label for="m">Male</label>
<input type="radio" id="f" name="gender" value="female"><label for="f">Female</label></p>
<p>Hobbies:
<input type="checkbox" id="read" name="hobby" value="reading"><label for="read">Reading</label>
<input type="checkbox" id="code" name="hobby" value="coding"><label for="code">Coding</label></p>
<p><label for="dob">DOB:</label>
<input type="date" id="dob" name="dob"></p>
</fieldset>
</form>
</body>
</html>
