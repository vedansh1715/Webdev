<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Assignment 17 - Form Validation</title>
</head>
<body>
<!-- method and action: valid data is sent by POST to submit.php -->
<form method="post" action="submit.php">
<p><input type="text" name="fullname" placeholder="Full name" required></p>
<!-- type="email" -> "Please include an '@' in the email address" -->
<p><input type="email" name="email" placeholder="you@college.edu" required></p>
<!-- pattern: exactly 10 digits -->
<p><input type="text" name="mobile" placeholder="10-digit mobile"
pattern="[0-9]{10}" title="Enter exactly 10 digits" required></p>
<!-- minlength: at least 6 characters -->
<p><input type="password" name="password" placeholder="Min 6 characters"
minlength="6" required></p>
<!-- min and max: 17 to 30 -->
<p><input type="number" name="age" placeholder="Age (17-30)"
min="17" max="30" required></p>
<p><button type="submit">Register</button></p>
</form>
</body>
</html>
